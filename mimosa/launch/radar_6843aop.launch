<!-- TI IWR6843AOP radar: publishes /ti_mmwave/radar_scan_pcl (x, y, z, intensity, velocity = mimosa
mmWavePoint) -->
<launch>
    <arg name="command_port" default="/dev/ttyUSB0" />
    <arg name="data_port" default="/dev/ttyUSB1" />

    <node pkg="ti_mmwave_rospkg" type="ti_mmwave_rospkg" name="ti_mmwave" output="screen">
        <param name="command_port" value="$(arg command_port)" />
        <param name="command_rate" value="115200" />
        <param name="data_port" value="$(arg data_port)" />
        <param name="data_rate" value="921600" />
        <param name="max_allowed_elevation_angle_deg" value="90" />
        <param name="max_allowed_azimuth_angle_deg" value="90" />
        <param name="frame_id" value="ti_mmwave" />
        <param name="mmWaveCLI_name" value="/mmWaveCLI" />
    </node>

    <!-- Sends the chirp config to the sensor, then exits -->
    <node pkg="ti_mmwave_rospkg" type="mmWaveQuickConfig" name="ti_mmwave_config"
        args="$(find ti_mmwave_rospkg)/cfg/6843AOP_3d.cfg" output="screen">
        <param name="mmWaveCLI_name" value="/mmWaveCLI" />
    </node>
</launch>
